# ==============================================================================
# INSTAGRAM AI V1 / KOALA AUTOMATION — CONFIGURAÇÃO DE AMBIENTE
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA versione o arquivo .env no Git!
# ==============================================================================

# --- AMBIENTE GERAL ---
ENVIRONMENT="DSV"                 # DSV, HMG ou PRD
APP_PORT=8080
LOG_LEVEL="INFO"
DATA_DIR="./data"

# --- TELEGRAM BOT ---
# Token obtido com o @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# Seu ID de usuário do Telegram (obtenha via @userinfobot) para autorização exclusiva
TELEGRAM_ALLOWED_USER_ID="123456789"

# --- GOOGLE AI (GEMINI & VEO) ---
# Chave da Google AI Studio para roteiros e vídeos
GEMINI_API_KEY="AIzaSy..."
GEMINI_TEXT_MODEL="gemini-2.5-flash"
VEO_VIDEO_MODEL="veo-2.0-generate-001"

# --- META GRAPH API (INSTAGRAM REELS) ---
# Obtidos no Meta for Developers (https://developers.facebook.com)
INSTAGRAM_APP_ID="123456789012345"
INSTAGRAM_APP_SECRET="abcdef0123456789abcdef0123456789"

# ID numérico da conta do Instagram Business / Creator
INSTAGRAM_ACCOUNT_ID="17841400000000000"

# Token de acesso de longa duração (60 dias) ou System User Token
INSTAGRAM_ACCESS_TOKEN="EAA..."

# URL pública base onde os vídeos temporários ficam acessíveis para a Meta baixar
# (Necessário na etapa de criação do container de mídia caso não use upload direto)
PUBLIC_MEDIA_BASE_URL="https://seu-servidor.meudominio.com/media"

# --- BANCO DE DADOS ---
DATABASE_URL="sqlite:///./data/instagram_ai.db"
